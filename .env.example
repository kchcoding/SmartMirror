# ── 위치 (기본값: 동아대학교 승학캠퍼스) ────────────────
LATITUDE=35.115446
LONGITUDE=128.967669
CITY_NAME=부산

# ── 센서 ──────────────────────────────
# mock   : 가짜 데이터 (아두이노 없이 노트북에서 개발할 때)
# serial : 실제 아두이노 연결
SENSOR_MODE=mock
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=9600
# 초음파 사람 감지: 이 거리(cm) 이내 + 이 시간(초) 동안 감지 없으면 화면 꺼짐
PRESENCE_DISTANCE_CM=120
PRESENCE_TIMEOUT_SEC=30

# ── 구글 캘린더 '비공개 iCal 주소' (비우면 데모 일정 표시) ──
ICS_URL=

# ── LLM (비우면 규칙 기반 문구로 대체) ──
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ── 우산 알림 기준 ─────────────────────
RAIN_PROB_THRESHOLD=50
RAIN_LOOKAHEAD_HOURS=12

# ── 코디 시착 (카메라 + MediaPipe 필요) ──
TRYON_ENABLED=false
CAMERA_INDEX=0
