# 설치:
#   sudo cp deploy/smart-mirror.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now smart-mirror
# (User 와 경로는 본인 환경에 맞게 수정)
[Unit]
Description=Smart Mirror server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/smart-mirror
ExecStart=/home/pi/smart-mirror/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
